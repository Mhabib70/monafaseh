# ============================================================
# Monafaseh — Environment Variables Example
# ============================================================
# این فایل را به .env کپی کنید و مقادیر را تغییر دهید.
#
# Docker این تنظیمات را از `.env.local` یا `.env.production` در ریشهٔ مخزن می‌گیرد.
# اجرای یکپارچه: از ریشهٔ مخزن `./debug.sh up-d` یا `./deploy.sh deploy` را اجرا کنید.
#
# برای توسعه‌ی محلی:
#   cp .env.example .env
#   npm install
#   npx prisma generate
#   npx prisma db push
#   npm run dev
# ============================================================

# ─── Database ────────────────────────────────────────────────
# SQLite برای توسعه و production سبک. برای production با ترافیک بالا،
# PostgreSQL یا MySQL توصیه می‌شود.
DATABASE_URL="file:./db/custom.db"

# ─── Authentication ──────────────────────────────────────────
# برای تولید: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string-please"

# آدرس سایت (بدون / در انتها). این فایل برای اجرای مستقیم خارج از Compose است.
NEXTAUTH_URL="http://localhost:3423"

# ─── Bale Bot (اختیاری) ─────────────────────────────────────
# فقط اگر ربات مدیریت Bale می‌خواهید
BOT_TOKEN=""
SITE_URL="http://localhost:3423"
# Real SEP payments require the registered public HTTPS origin and terminal.
# Localhost never simulates a successful payment.
SAMAN_TERMINAL_ID=""
SAMAN_MERCHANT_ID=""

# ─── Docker-specific (اختیاری) ──────────────────────────────
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
