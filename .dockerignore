# ============================================================
# .dockerignore — فایل‌هایی که نباید در تصویر Docker کپی شوند
# ============================================================
# این فایل باعث می‌شود build سریع‌تر شود و تصویر کوچک‌تر.

# وابستگی‌ها (در Docker نصب می‌شوند)
node_modules
.next
out
build
dist

# فایل‌های سیستمی
.git
.gitignore
.DS_Store
*.log
dev.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# فایل‌های محیطی
.env
.env.local
.env.development
.env.production
.env*.local

# فایل‌های تست
coverage
.nyc_output
test
tests
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# اسکریپت‌های توسعه که در production نیاز نیست
scripts/test-*.ts
scripts/find-admin.ts
scripts/make-session.ts
scripts/check-db.ts

# فایل‌های آپلودشده (در volume ذخیره می‌شوند)
public/uploads/*
!public/uploads/.gitkeep

# دیتابیس (در volume ذخیره می‌شود)
db/*
!db/.gitkeep

# مستندات و README
README.md
DEPLOYMENT.md
worklog.md
download
upload
tool-results
.zscripts
.z-ai-config
.claude

# IDE
.vscode
.idea
*.swp
*.swo

# Docker خودش
Dockerfile
docker-compose.yml
.dockerignore

# Skills و examples (مربوط به development هستند)
skills
examples
mini-services
